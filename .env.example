# ── Database ────────────────────────────────────────────────────────────────
# Leave empty to use a local SQLite file (data/lokeify.db).
# On Vercel set these (the Turso integration in Vercel Marketplace adds them for you),
# otherwise the deployment runs in "demo mode" and loses data on every cold start.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Security ────────────────────────────────────────────────────────────────
# Signs sessions and encrypts stores' API keys (any long random string, 32+ characters).
# If unset, a random secret is generated once and stored in the database.
LOKEIFY_SECRET=

# ── Photo try-on ────────────────────────────────────────────────────────────
# Optional fallback try-on key used by EVERY store that hasn't added its own.
MODEL_API_KEY=
